# Copy to .env for local development: cp .env.example .env

# Postgres from docker-compose.yml (pnpm db:up).
DATABASE_URL=postgres://rfq:rfq@localhost:5432/rfq

# GroqCloud API key: https://console.groq.com/keys
LLM_API_KEY=replace-me

# Optional. Defaults shown.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Optional. Set to 1 to swap in the fake LLM client and show the fault selector (FAIL-6).
# FAULT_INJECTION=0
