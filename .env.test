# Committed on purpose: test defaults, loaded when NODE_ENV=test (Vitest). Next.js skips .env.local in tests.
# Integration tests create their own database on this server per run (src/test/global-setup.ts).
DATABASE_URL=postgres://rfq:rfq@localhost:5432/rfq

# Not a real key, so a test can never call the real model by accident.
LLM_API_KEY=test-key-not-real
